# Copy this file to .env and adjust values for your machine.  Never commit .env.

# Flask
FLASK_ENV=development
# Generate your own with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
APP_HOST=127.0.0.1
APP_PORT=8000
# Set to 1 only when serving over HTTPS
SESSION_COOKIE_SECURE=0

# PostgreSQL application database (Docker default from docker-compose.yml uses port 5433)
DATABASE_URL=postgresql+psycopg://route_planner:route_planner_dev@localhost:5433/route_planner
# Separate database used by the automated test suite (created automatically)
TEST_DATABASE_URL=postgresql+psycopg://route_planner:route_planner_dev@localhost:5433/route_planner_test

# Docker Compose variables (only used by docker-compose.yml)
POSTGRES_USER=route_planner
POSTGRES_PASSWORD=route_planner_dev
POSTGRES_DB=route_planner
POSTGRES_PORT=5433

# External services
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OSRM_URL=https://router.project-osrm.org
# 1 = try the public OSRM demo server for driving estimates (falls back to heuristic)
ENABLE_OSRM=1
EXTERNAL_TIMEOUT_SECONDS=8

# Time zone for PostgreSQL session timestamps
DB_TIMEZONE=America/Toronto
